{
  "expo": {
    "name": "LinguaPlay",
    "slug": "linguaplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["android", "ios", "web"],
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.linguaplay.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.linguaplay.app",
      "buildNumber": "1"
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
