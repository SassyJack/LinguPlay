# Firebase Configuration - COPY THIS TO .env.local AND FILL IN YOUR VALUES
# This file should NOT be committed to git (it's in .gitignore)

# Get these values from Firebase Console > Project Settings > Your apps > Web
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Steps to get these values:
# 1. Go to https://console.firebase.google.com
# 2. Create a project named "linguaplay"
# 3. Add a Web app
# 4. Copy the config object
# 5. Fill in the values above
# 6. Rename this file to .env.local
# 7. Enable Realtime Database and Email Auth in Firebase Console

# See FIREBASE_SETUP.md for detailed instructions
